# ==============================================================================
# CABINET MANAGER — .env.example
# Copier en ".env" et renseigner des valeurs réelles avant "docker compose up".
# NE JAMAIS committer le fichier ".env" réel dans Git (voir .gitignore).
# ==============================================================================

# ---- Domaine ----
DOMAIN=cabinetmanager.cm
ACME_EMAIL=infra@cabinetmanager.cm

# ---- PostgreSQL (2.2) ----
POSTGRES_DB=cabinet_manager
POSTGRES_USER=cm_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CM_APP_USER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- MinIO / Stockage documentaire (2.3) ----
MINIO_ROOT_USER=CHANGE_ME_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_20_CHARS_MIN
MINIO_APP_ACCESS_KEY=cm_app_storage
MINIO_APP_SECRET_KEY=CHANGE_ME_STRONG_SECRET
# Clé locale pour le chiffrement SSE (32 octets encodés base64) :
# générer avec: openssl rand -base64 32
MINIO_KMS_SECRET_KEY=my-minio-key:CHANGE_ME_BASE64_KEY

# ---- Traefik / API Gateway (2.4) ----
# Générer le fichier admin_htpasswd avec : htpasswd -nbB admin 'motdepasse' > traefik/admin_htpasswd
