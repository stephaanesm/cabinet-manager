# ==============================================================================
# CABINET MANAGER — backend/.env.example
# Copier en ".env" et renseigner les valeurs avant de démarrer le serveur.
# NE JAMAIS committer le ".env" réel dans Git.
# ==============================================================================

# ---- Serveur ----
NODE_ENV=development
PORT=8080

# ---- Base de données PostgreSQL (voir infrastructure/.env.example) ----
# En développement : pointer vers localhost:5432
# En production (Docker) : pointer vers le service "postgres-primary" du réseau backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cabinet_manager
# Utiliser cm_app_user en production (droits restreints, voir infrastructure/postgres/grants_app_role.sql)
DB_USER=cm_admin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- JWT ----
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTES_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_BYTES_HEX_STRING

# ---- 2FA (TOTP) ----
# Clé de chiffrement du secret TOTP stocké en base (AES-256 = 32 octets)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX_STRING

# ---- MinIO / Stockage documentaire (voir infrastructure/.env.example) ----
# En développement : pointer vers localhost:9000
# En production : pointer vers le service "minio" du réseau backend (jamais exposé publiquement)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=cm_app_storage
MINIO_SECRET_KEY=CHANGE_ME_STRONG_SECRET
MINIO_BUCKET_DOCUMENTS=cabinet-manager-documents

# ---- CORS ----
# En production, restreindre à l'URL de l'application mobile / web
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
